{
  "app": "node bin/icecore.js",
  "watch": {
    "include": [
      "**"
    ],
    "exclude": [
      "README.md",
      "node_modules/**",
      "cdk.out/**"
    ]
  },
  "context": {
    "@aws-cdk/aws-lambda:recognizeLayerVersion": true,
    "@aws-cdk/core:checkSecretUsage": true,
    "@aws-cdk/aws-iam:minimizePolicies": true,
    "@aws-cdk/core:validateSnapshotRemovalPolicy": true,
    "@aws-cdk/aws-s3:createDefaultLoggingPolicy": true,
    "@aws-cdk/aws-cloudfront:useOriginAccessControl": true,
    "adminEmail": "keith@icecampus.com",
    "alertEmail": "keith@icecampus.com",
    "siteDomain": "icecore.icecampus.com",
    "siteCertificateArn": "arn:aws:acm:us-east-1:845106282768:certificate/4f2343ee-902c-42aa-a848-76e7c5218bdd",
    "inviteFromEmail": "noreply@icecampus.com",
    "orgName": "ICE Campus (Institute of Computer Education Ltd.)",
    "privacyContact": "student@icecampus.com"
  }
}
